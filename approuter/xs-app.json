{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": { "logoutEndpoint": "/do/logout", "logoutPage": "/index.html#Shell-home" },
  "errorPage": [{ "status": [403], "file": "./error/403.html" }],
  "routes": [
    {
      "source": "^/user-api(.*)$",
      "target": "$1",
      "service": "sap-approuter-userapi",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/odata/v4/supplier/(register|login|submitApplication|reapplyApplication)$",
      "target": "/odata/v4/supplier/$1",
      "destination": "cap-backend",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/odata/v4/supplier/(myApplicationStatus|myApplicationDetails)(\\(.*\\))$",
      "target": "/odata/v4/supplier/$1$2",
      "destination": "cap-backend",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/$",
      "target": "/index.html",
      "localDir": "../app",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/index.html$",
      "target": "/index.html",
      "localDir": "../app",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/appconfig/(.*)$",
      "target": "/appconfig/$1",
      "localDir": "../app",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/assets/(.*)$",
      "target": "/assets/$1",
      "localDir": "../app",
      "authenticationType": "none"
    },
    {
      "source": "^/supplier-portal/(.*)$",
      "target": "/supplier-portal/$1",
      "localDir": "../app",
      "authenticationType": "none"
    },
    {
      "source": "^/supplier-approvals/(.*)$",
      "target": "/supplier-approvals/$1",
      "localDir": "../app",
      "authenticationType": "xsuaa",
      "scope": ["$XSAPPNAME.Approval"]
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "cap-backend",
      "authenticationType": "xsuaa",
      "scope": ["$XSAPPNAME.Approval"],
      "csrfProtection": true
    }
  ]
}