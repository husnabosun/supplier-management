<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <ViewSettingsDialog
        id="viewSettingsDialog"
        confirm=".onSettingsConfirm"
        resetFilters=".onSettingsReset">
        <customTabs>
            <ViewSettingsCustomTab id="sortCustomTab" icon="sap-icon://sort" title="{i18n>approvals.sortTabTitle}">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Text text="{i18n>approvals.sortIntro}" class="sapUiTinyMarginBottom" />
                        <RadioButtonGroup id="sortOptions" columns="1" selectedIndex="5" select=".onSortSelect">
                            <RadioButton text="{i18n>approvals.sortCompanyAsc}" />
                            <RadioButton text="{i18n>approvals.sortCompanyDesc}" />
                            <RadioButton text="{i18n>approvals.sortContactAsc}" />
                            <RadioButton text="{i18n>approvals.sortContactDesc}" />
                            <RadioButton text="{i18n>approvals.sortDateAsc}" />
                            <RadioButton text="{i18n>approvals.sortDateDesc}" />
                        </RadioButtonGroup>
                    </VBox>
                </content>
            </ViewSettingsCustomTab>
        </customTabs>
        <filterItems>
            <ViewSettingsFilterItem key="category" text="{i18n>approvals.colCategory}" multiSelect="true">
                <items>
                    <ViewSettingsItem key="Hardware" text="{i18n>approvals.categoryHardware}" />
                    <ViewSettingsItem key="Software" text="{i18n>approvals.categorySoftware}" />
                    <ViewSettingsItem key="Services" text="{i18n>approvals.categoryServices}" />
                    <ViewSettingsItem key="Consulting" text="{i18n>approvals.categoryConsulting}" />
                    <ViewSettingsItem key="Other" text="{i18n>approvals.categoryOther}" />
                </items>
            </ViewSettingsFilterItem>
        </filterItems>
    </ViewSettingsDialog>
</core:FragmentDefinition>
