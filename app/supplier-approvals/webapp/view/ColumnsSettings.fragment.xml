<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <ResponsivePopover
        id="columnsPopover"
        title="{i18n>approvals.columnsPopoverTitle}"
        placement="Bottom">
        <content>
            <List>
                <InputListItem label="{i18n>approvals.colPhone}">
                    <CheckBox selected="{ui>/columns/phone}" select=".onColumnToggle" />
                </InputListItem>
                <InputListItem label="{i18n>approvals.colCountry}">
                    <CheckBox selected="{ui>/columns/country}" select=".onColumnToggle" />
                </InputListItem>
                <InputListItem label="{i18n>approvals.colCategory}">
                    <CheckBox selected="{ui>/columns/category}" select=".onColumnToggle" />
                </InputListItem>
                <InputListItem label="{i18n>approvals.colTaxNumber}">
                    <CheckBox selected="{ui>/columns/taxNumber}" select=".onColumnToggle" />
                </InputListItem>
                <InputListItem label="{i18n>approvals.colWebsite}">
                    <CheckBox selected="{ui>/columns/website}" select=".onColumnToggle" />
                </InputListItem>
                <InputListItem label="{i18n>approvals.colAddress}">
                    <CheckBox selected="{ui>/columns/address}" select=".onColumnToggle" />
                </InputListItem>
                <InputListItem label="{i18n>approvals.colNotes}">
                    <CheckBox selected="{ui>/columns/notes}" select=".onColumnToggle" />
                </InputListItem>
            </List>
        </content>
    </ResponsivePopover>
</core:FragmentDefinition>
