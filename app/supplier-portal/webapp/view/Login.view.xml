<mvc:View
    controllerName="supplier.portal.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="{i18n>login.pageTitle}" showHeader="true">
        <content>
            <VBox class="sapUiResponsiveMargin" alignItems="Center">
                <Panel width="24rem" headerText="{i18n>login.formTitle}" class="sapUiResponsiveMargin">
                    <content>
                <VBox width="100%">
                    <Label text="{i18n>common.email}" labelFor="loginEmail" />
                    <Input id="loginEmail" type="Email" placeholder="{i18n>common.emailPlaceholder}" />

                    <Label text="{i18n>common.password}" labelFor="loginPassword" class="sapUiTinyMarginTop" />
                    <Input id="loginPassword" type="Password" />

                    <MessageStrip
                        id="loginError"
                        type="Error"
                        showIcon="true"
                        class="sapUiSmallMarginTop"
                        visible="false" />

                    <Button
                        text="{i18n>login.button}"
                        type="Emphasized"
                        class="sapUiMediumMarginTop"
                        press=".onLoginPress" />

                    <Button
                        text="{i18n>login.goToRegister}"
                        type="Transparent"
                        class="sapUiTinyMarginTop"
                        press=".onNavToRegister" />
                </VBox>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>